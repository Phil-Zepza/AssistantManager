# FPL / LMS Assistant — web app environment.
# Copy to .env.local for local dev; set the same vars in Vercel for production.
# NONE of these are NEXT_PUBLIC_* — they are server-only and never reach the browser.

# Railway Postgres connection string (same DB the pipeline writes to).
# For Vercel, use the PUBLIC/pooled Railway URL. SSL may be required on the public URL.
DATABASE_URL=postgresql://user:password@host:5432/railway

# Random secret for Auth.js session/JWT signing. Generate with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-string

# Resend API key for sending magic-link emails.
AUTH_RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified Resend from-address (domain must be verified in Resend).
AUTH_EMAIL_FROM=login@yourdomain.com

# Deployed app URL. http://localhost:3000 locally; your Vercel URL in production.
AUTH_URL=http://localhost:3000
